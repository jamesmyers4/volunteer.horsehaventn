# Drover validation database — a throwaway local Postgres (docker-compose.drover.yml),
# fully separate from docker-compose.test.yml's own E2E-suite container. Never Neon.
# Both vars point at the same local instance since there's no PgBouncer involved locally;
# copy this file to .env.drover (already gitignored) and these defaults will just work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/volunteer_ops_drover"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/volunteer_ops_drover"
